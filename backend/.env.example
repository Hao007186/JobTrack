# 複製成 backend/.env 後使用；.env 不進 Git
# 在 Windows 上用 uv run 執行時連 localhost；compose 內的 api 會改用主機名稱 postgres（見 deploy/docker-compose.yml）
DATABASE_URL=postgresql+psycopg://farewatch:farewatch@localhost:5432/farewatch
TEST_DATABASE_URL=postgresql+psycopg://farewatch:farewatch@localhost:5432/farewatch_test
ENV=local
LOG_LEVEL=INFO

# 簽 access token 的密鑰；正式環境要換成隨機長字串（例如 python -c "import secrets; print(secrets.token_urlsafe(48))"）
JWT_SECRET=change-me-local-dev-secret-at-least-32-bytes
# 本機用 http 開發時設 false，否則瀏覽器不會送出 refresh cookie
COOKIE_SECURE=false

# docker compose 的 postgres 服務使用
POSTGRES_USER=farewatch
POSTGRES_PASSWORD=farewatch
POSTGRES_DB=farewatch
